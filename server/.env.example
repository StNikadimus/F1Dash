# Copy to server/.env (read by server/launch.sh, the systemd unit and docker compose).
# Never commit the real values.
#
# F1 TV subscription token (optional - otherwise the stored sign-in, see server/README.md)
F1TV_TOKEN=
# Mode at start: auto | live | vod | test | replay  (switchable on the dashboard)
F1DASH_SOURCE_MODE=auto
# Shared secret for the VOYO clock bridge / remote control from other machines (recommended on a LAN server)
F1DASH_REMOTE_TOKEN=
TZ=Europe/Ljubljana
