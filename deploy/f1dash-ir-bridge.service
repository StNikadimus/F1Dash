# systemd unit for the IR receiver bridge (Linux machine with an IR receiver).
#   sudo cp deploy/f1dash-ir-bridge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now f1dash-ir-bridge
[Unit]
Description=F1 dashboard IR remote bridge (evdev -> HTTP)
After=network-online.target

[Service]
# load the WD TV Live keymap into the kernel IR decoder first
ExecStartPre=/usr/bin/ir-keytable -c -p nec -w /opt/f1-dashboard/bridge/keymaps/wdtv_live.toml
ExecStart=/opt/f1-dashboard/.venv/bin/python /opt/f1-dashboard/bridge/evdev_bridge.py --server http://127.0.0.1:8080 --name gpio_ir_recv
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
